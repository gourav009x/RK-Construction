# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Configuration (Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.fu787v0.mongodb.net/rk_construction?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# Public API URL
API_PUBLIC_URL=https://your-backend-app.onrender.com/api

# Frontend URL (or * to allow any)
CLIENT_ORIGIN=https://your-frontend-app.onrender.com

# Email Notifications (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-gmail-app-password
ENQUIRY_TO_EMAIL=your-recipient-email@gmail.com

# Setup Key for one-time admin creation
SETUP_KEY=your_admin_setup_key_here
